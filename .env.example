# Copie este arquivo para .env e preencha somente no ambiente local.
# Nunca versione o arquivo .env real.
SUPABASE_DB_URL=postgresql://HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=USUARIO_DO_BANCO
SUPABASE_DB_PASSWORD=SENHA_DO_BANCO
DB_SCHEMA=public

# Storage privado da API REST principal.
DOCUMENT_STORAGE_PATH=./data/documentos
MAX_PDF_SIZE=25MB
MAX_PNG_SIZE=10MB
MAX_MULTIPART_REQUEST_SIZE=26MB

# Segurança JWT. Ative após definir o provedor e o JWKS do ambiente.
SECURITY_ENABLED=false
JWT_ISSUER_URI=https://SEU-PROJETO.supabase.co/auth/v1
JWT_JWK_SET_URI=https://SEU-PROJETO.supabase.co/auth/v1/.well-known/jwks.json
JWT_AUDIENCE=efficientia-api
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
