# ==============================================================================
# EFFICIENTIA API - EXEMPLO DE CONFIGURAÇÃO DE AMBIENTE (.env)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para ".env" na raiz do projeto (cp .env.example .env).
# 2. Preencha os valores de acordo com seu ambiente local ou de homologação.
# 3. NUNCA versione o arquivo ".env" real contendo credenciais de produção.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Conexão primária com a base relacional PostgreSQL / Supabase.
# Observação sobre aliases de compatibilidade:
# - A API também aceita "DATABASE_URL" como alias de "SUPABASE_DB_URL".
# - A API também aceita "SUPABASE_DB_USER" como alias de "SUPABASE_DB_USERNAME".
SUPABASE_DB_URL=postgresql://HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=USUARIO_DO_BANCO
SUPABASE_DB_PASSWORD=SENHA_DO_BANCO

# Schema padrão de controle/metadados e tabelas públicas da aplicação:
DB_SCHEMA=public

# Lista com todos os schemas canônicos sincronizados com o repositório Efficientia-database:
DB_SCHEMAS=public,sc_corporativo,sc_frota,sc_operacao,sc_auditoria

# ------------------------------------------------------------------------------
# 2. POOL DE CONEXÕES HIKARICP E TIMEOUTS
# ------------------------------------------------------------------------------
# Configurações de dimensionamento e tolerância a latência do pool HikariCP.
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=30000
DB_INITIALIZATION_FAIL_TIMEOUT_MS=60000
DB_CONNECT_TIMEOUT_SECONDS=30
DB_SSL_RESPONSE_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 3. STORAGE DE ARQUIVOS LOCAIS (Documentos e Assinaturas)
# ------------------------------------------------------------------------------
# Diretório local para armazenamento de relatórios PDF e assinaturas PNG.
DOCUMENT_STORAGE_PATH=./data/documentos
MAX_PDF_SIZE=25MB
MAX_PNG_SIZE=10MB
MAX_MULTIPART_REQUEST_SIZE=26MB

# ------------------------------------------------------------------------------
# 4. SEGURANÇA E AUTENTICAÇÃO JWT
# ------------------------------------------------------------------------------
# Em desenvolvimento local, pode ser mantido "false" para facilitar testes rápidos.
# OBRIGATÓRIO: Definir como "true" em ambientes de produção/staging.
SECURITY_ENABLED=false
JWT_SECRET=coloque-aqui-uma-chave-secreta-com-pelo-menos-32-caracteres!
JWT_ISSUER_URI=https://SEU-PROJETO.supabase.co/auth/v1
JWT_JWK_SET_URI=https://SEU-PROJETO.supabase.co/auth/v1/.well-known/jwks.json
JWT_AUDIENCE=efficientia-api
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ----------------------------------------------------------------------    --------
# 5. CACHE E STREAMING REDIS / UPSTASH
# ------------------------------------------------------------------------------
# Integração com Redis para streaming de eventos de viagens e leaderboard.
REDIS_URL=rediss://default:SEU_TOKEN_AQUI@SEU_HOST.upstash.io:6379
REDIS_STREAM_VIAGENS=efficientia:events:viagens
REDIS_LEADERBOARD_KEY=efficientia:leaderboard:motoristas
REDIS_HEALTH_ENABLED=false

# ------------------------------------------------------------------------------
# 6. SERVIDOR E OBSERVABILIDADE
# ------------------------------------------------------------------------------
# Porta de escuta da aplicação e metadados de build/deploy.
PORT=8080
SERVER_ADDRESS=0.0.0.0
RENDER_GIT_COMMIT=local-dev
